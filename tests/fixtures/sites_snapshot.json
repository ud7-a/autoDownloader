  "schedule_urls": {
    "eta.animerco.org": "https://eta.animerco.org/schedule/",
    "witanime.life": "https://witanime.life/مواعيد-الحلقات/"
  },
  "site_flows": {
    "eta.animerco.org": {
      "next_btn_xpath": "الحلقة التالية",
      "step_paths": {
        "google drive": [
          {
            "delay": 5.0,
            "xpath": "//tr[.//div[contains(@data-src,'drive.google')]]//a[contains(@class,'labeled')]"
          },
          {
            "delay": 3.0,
            "xpath": "Download anyway"
          }
        ],
        "mediafire": [
          {
            "delay": 5.0,
            "xpath": "//tr[.//div[contains(@data-src,'mediafire')]]//a[contains(@class,'labeled')]"
          },
          {
            "delay": 3.0,
            "xpath": "//*[@id=\"downloadButton\"]"
          }
        ]
      }
    },
    "witanime.life": {
      "next_btn_xpath": "الحلقة التالية",
      "step_paths": {
        "Workupload": [
          {
            "delay": 5.0,
            "xpath": "workupload #last"
          },
          {
            "delay": 5.0,
            "xpath": "//*[@id=\\\"file\\\"]/div[3]/div/a"
          }
        ],
        "google drive": [
          {
            "delay": 3.0,
            "xpath": "google drive #last"
          },
          {
            "delay": 2.0,
            "xpath": "Download anyway"
          }
        ],
        "mediafire": [
          {
            "delay": 7.0,
            "xpath": "mediafire #last"
          },
          {
            "delay": 3.0,
            "xpath": "//*[@id=\"downloadButton\"]"
          }
        ],
        "rf": [
          {
            "delay": 11.0,
            "xpath": "rf #last"
          },
          {
            "delay": 2.0,
            "xpath": "//*[@id=\"downloadButton\"]"
          }
        ]
      }
    }
  },
  "supported_sites": {
    "eta.animerco.org": "https://eta.animerco.org/?s={query}",
    "witanime.life": "https://witanime.life/?search_param=animes&s={query}"
  }
}