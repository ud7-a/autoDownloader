    ]
  },
  "schedule_match": {
    "eta.animerco.org": "title",
    "witanime.site": "url"
  },
  "schedule_urls": {
    "eta.animerco.org": "https://eta.animerco.org/schedule/",
    "witanime.site": "https://witanime.site/schedule"
  },
  "site_flows": {
    "eta.animerco.org": {
      "next_btn_xpath": "الحلقة التالية",
      "step_paths": {
        "google drive": [
          {
            "delay": 5.0,
            "xpath": "//tr[.//div[contains(@data-src,'drive.google')]]//a[contains(@class,'labeled')]"
          },
          {
            "delay": 3.0,
            "xpath": "Download anyway"
          }
        ],
        "mediafire": [
          {
            "delay": 5.0,
            "xpath": "//tr[.//div[contains(@data-src,'mediafire')]]//a[contains(@class,'labeled')]"
          },
          {
            "delay": 3.0,
            "xpath": "//*[@id=\"downloadButton\"]"
          }
        ]
      }
    },
    "witanime.site": {
      "next_btn_xpath": "الحلقة التالية",
      "step_paths": {
        "FHD - Google Drive": [
          {
            "delay": 2.0,
            "xpath": "//h2[contains(text(), 'تحميل')]/following-sibling::div//button[contains(., 'FHD')]"
          },
          {
            "delay": 3.0,
            "xpath": "//h2[contains(text(), 'تحميل')]/following-sibling::div//div[contains(@class, 'rounded-xl') and .//button[contains(., 'FHD')]]//button[contains(translate(., 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'google')]"
          },
          {
            "delay": 2.0,
            "xpath": "Download anyway"
          }
        ],
        "FHD - Mediafire": [
          {
            "delay": 1.0,
            "xpath": "//h2[contains(text(), 'تحميل')]/following-sibling::div//button[contains(., 'FHD')]"
          },
          {
            "delay": 5.0,
            "xpath": "//h2[contains(text(), 'تحميل')]/following-sibling::div//div[contains(@class, 'rounded-xl') and .//button[contains(., 'FHD')]]//button[contains(translate(., 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'mediafire')]"
          },
          {
            "delay": 2.0,
            "xpath": "//*[@id=\"downloadButton\"]"
          }
        ],
        "FHD - Workupload": [
          {
            "delay": 2.0,
            "xpath": "//h2[contains(text(), 'تحميل')]/following-sibling::div//button[contains(., 'FHD')]"
          },
          {
            "delay": 5.0,
            "xpath": "//h2[contains(text(), 'تحميل')]/following-sibling::div//div[contains(@class, 'rounded-xl') and .//button[contains(., 'FHD')]]//button[contains(translate(., 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'workupload')]"
          },
          {
            "delay": 2.0,
            "xpath": "//*[@id=\"file\"]/div[3]/div/a"
          }
        ],
        "FHD - gofile": [
          {
            "delay": 1.0,
            "xpath": "//h2[contains(text(), 'تحميل')]/following-sibling::div//button[contains(., 'FHD')]"
          },
          {
            "delay": 5.0,
            "xpath": "//h2[contains(text(), 'تحميل')]/following-sibling::div//div[contains(@class, 'rounded-xl') and .//button[contains(., 'FHD')]]//button[contains(translate(., 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'gofile')]"
          },
          {
            "delay": 2.0,
            "xpath": "//button[@data-action='download']"
          }
        ],
        "FHD - mp4upload": [
          {
            "delay": 2.0,
            "xpath": "//h2[contains(text(), 'تحميل')]/following-sibling::div//button[contains(., 'FHD')]"
          },
          {
            "delay": 5.0,
            "xpath": "//h2[contains(text(), 'تحميل')]/following-sibling::div//div[contains(@class, 'rounded-xl') and .//button[contains(., 'FHD')]]//button[contains(translate(., 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'mp4upload')]"
          },
          {
            "delay": 3.0,
            "script": "if (window.location.href.includes('mp4upload.com') && !window.location.href.includes('embed-')) { window.location.href = window.location.href.replace(/mp4upload\\.com\\/([a-zA-Z0-9]+)/, 'mp4upload.com/embed-$1.html'); } return null;"
          },
          {
            "delay": 2.0,
            "script": "let src = null; let v = document.querySelector('video'); if (v && v.src && !v.src.startsWith('blob:')) return v.src; let scripts = document.querySelectorAll('script'); for (let s of scripts) { let match = s.innerHTML.match(/eval\\((function\\(p,a,c,k,e,d\\)[\\s\\S]*?split\\('\\|'\\).*?)\\)/); if (match) { try { let unpacked = eval(match[1]); let m = unpacked.match(/player\\.src\\(\\\"([^\\\"]+)\\\"\\)/) || unpacked.match(/src:\\\"([^\\\"]+)\\\"/); if (m) src = m[1]; } catch(e) {} } } return src;"
          }
        ],
        "FHD - wahmi": [
          {
            "delay": 1.0,
            "xpath": "//h2[contains(text(), 'تحميل')]/following-sibling::div//button[contains(., 'FHD')]"
          },
          {
            "delay": 4.0,
            "xpath": "//h2[contains(text(), 'تحميل')]/following-sibling::div//div[contains(@class, 'rounded-xl') and .//button[contains(., 'FHD')]]//button[contains(translate(., 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'wahmi')]"
          },
          {
            "delay": 2.0,
            "script": "let csrf = document.querySelector('meta[name=\"csrf-token\"]')?.getAttribute('content'); let dlId = (typeof downloadId !== 'undefined' ? downloadId : null) || window.location.pathname.split('/')[1]; let base = (typeof config !== 'undefined' && config.baseURL ? config.baseURL : window.location.origin); let url = base + '/' + dlId + '/download/create'; return (async () => { try { let resp = await fetch(url, { method: 'POST', headers: { 'X-CSRF-TOKEN': csrf, 'Content-Type': 'application/json', 'Accept': 'application/json' } }); let data = await resp.json(); if (data && data.download_link) return data.download_link; } catch(e) {} let a = document.querySelector('a.download-link'); if (a && a.href) return a.href; return null; })();"
          }
        ],
        "FHD - wtsrv": [
          {
            "delay": 1.0,
            "xpath": "//h2[contains(text(), 'تحميل')]/following-sibling::div//button[contains(., 'FHD')]"
          },
          {
            "delay": 5.0,
            "xpath": "(//h2[contains(text(), 'تحميل')]/following-sibling::div//div[contains(@class, 'rounded-xl') and .//button[contains(., 'FHD')]]//button[contains(translate(., 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'wtsrv')])[last()]"
          },
          {
            "delay": 2.0,
            "xpath": "//*[@id=\"downloadButton\"]"
          }
        ]
      }
    }
  },
  "supported_sites": {
    "eta.animerco.org": "https://eta.animerco.org/?s={query}",
    "witanime.site": "https://witanime.site/search?q={query}"
  }
}