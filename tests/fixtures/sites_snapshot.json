{
  "dns_hosts": [
    "witanime.site",
    "www.witanime.site",
    "eta.animerco.org",
    "det.animerco.org",
    "animerco.org",
    "www.animerco.org",
    "www.mediafire.com",
    "mediafire.com",
    "drive.google.com",
    "drive.usercontent.google.com",
    "workupload.com",
    "www.workupload.com",
    "mp4upload.com",
    "www.mp4upload.com",
    "yourupload.com",
    "www.yourupload.com",
    "mega.nz"
  ],
  "path_hosts": {
    "4shared": [
      "4shared.com"
    ],
    "google drive": [
      "drive.google.com",
      "drive.usercontent.google.com",
      "docs.google.com",
      "googleusercontent.com"
    ],
    "mediafire": [
      "mediafire.com"
    ],
    "mega": [
      "mega.nz",
      "mega.io"
    ],
    "workupload": [
      "workupload.com"
    ],
    "yourupload": [
      "yourupload.com"
    ]
  },
  "schedule_match": {
    "eta.animerco.org": "title",
    "witanime.site": "url"
  },
  "schedule_urls": {
    "eta.animerco.org": "https://eta.animerco.org/schedule/",
    "witanime.site": "https://witanime.site/schedule"
  },
  "site_flows": {
    "eta.animerco.org": {
      "next_btn_xpath": "الحلقة التالية",
      "step_paths": {
        "google drive": [
          {
            "delay": 5.0,
            "xpath": "//tr[.//div[contains(@data-src,'drive.google')]]//a[contains(@class,'labeled')]"
          },
          {
            "delay": 3.0,
            "xpath": "Download anyway"
          }
        ],
        "mediafire": [
          {
            "delay": 5.0,
            "xpath": "//tr[.//div[contains(@data-src,'mediafire')]]//a[contains(@class,'labeled')]"
          },
          {
            "delay": 3.0,
            "xpath": "//*[@id=\"downloadButton\"]"
          }
        ]
      }
    },
    "witanime.site": {
      "next_btn_xpath": "الحلقة التالية",
      "step_paths": {
        "FHD - Google Drive": [
          {
            "delay": 2.0,
            "xpath": "//h2[contains(text(), 'تحميل')]/following-sibling::div//button[contains(., 'FHD')]"
          },
          {
            "delay": 3.0,
            "xpath": "//h2[contains(text(), 'تحميل')]/following-sibling::div//div[contains(@class, 'rounded-xl') and .//button[contains(., 'FHD')]]//button[contains(translate(., 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'google')]"
          },
          {
            "delay": 2.0,
            "xpath": "Download anyway"
          }
        ],
        "FHD - Mediafire": [
          {
            "delay": 1.0,
            "xpath": "//h2[contains(text(), 'تحميل')]/following-sibling::div//button[contains(., 'FHD')]"
          },
          {
            "delay": 5.0,
            "xpath": "//h2[contains(text(), 'تحميل')]/following-sibling::div//div[contains(@class, 'rounded-xl') and .//button[contains(., 'FHD')]]//button[contains(translate(., 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'mediafire')]"
          },
          {
            "delay": 2.0,
            "xpath": "//*[@id=\"downloadButton\"]"
          }
        ],
        "FHD - Workupload": [
          {
            "delay": 2.0,
            "xpath": "//h2[contains(text(), 'تحميل')]/following-sibling::div//button[contains(., 'FHD')]"
          },
          {
            "delay": 5.0,
            "xpath": "//h2[contains(text(), 'تحميل')]/following-sibling::div//div[contains(@class, 'rounded-xl') and .//button[contains(., 'FHD')]]//button[contains(translate(., 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'workupload')]"
          },
          {
            "delay": 2.0,
            "xpath": "//*[@id=\"file\"]/div[3]/div/a"
          }
        ],
        "FHD - gofile": [
          {
            "delay": 1.0,
            "xpath": "//h2[contains(text(), 'تحميل')]/following-sibling::div//button[contains(., 'FHD')]"
          },
          {
            "delay": 5.0,
            "xpath": "//h2[contains(text(), 'تحميل')]/following-sibling::div//div[contains(@class, 'rounded-xl') and .//button[contains(., 'FHD')]]//button[contains(translate(., 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'gofile')]"
          },
          {
            "delay": 2.0,
            "xpath": "//button[@data-action='download']"
          }
        ],
        "FHD - wtsrv": [
          {
            "delay": 1.0,
            "xpath": "//h2[contains(text(), 'تحميل')]/following-sibling::div//button[contains(., 'FHD')]"
          },
          {
            "delay": 5.0,
            "xpath": "//h2[contains(text(), 'تحميل')]/following-sibling::div//div[contains(@class, 'rounded-xl') and .//button[contains(., 'FHD')]]//button[contains(translate(., 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'wtsrv')]"
          },
          {
            "delay": 2.0,
            "xpath": "//*[@id=\"downloadButton\"]"
          }
        ]
      }
    }
  },
  "supported_sites": {
    "eta.animerco.org": "https://eta.animerco.org/?s={query}",
    "witanime.site": "https://witanime.site/search?q={query}"
  }
}