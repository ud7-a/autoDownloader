# PyInstaller & Compilation Artifacts
build/
dist/
*.spec

# Local dev/release tooling -- kept on the maintainer's machine, not published.
# publish.py is retired: it carried its own copy of the PyInstaller flags, drifted
# out of sync, and shipped 4.3.0 with no app icon. Releases now go through
# .github/workflows/release.yml. See RELEASING.md.
exeCompile.py
publish.py*

# Package Deliverables (Uploaded directly to Releases)
*.zip
*.exe

# Exception: bundled downloader binaries must ship with the app/installer
!tools/aria2c.exe
!tools/unrar.exe

# Python Execution Caches
__pycache__/
*.pyc
*.pyo
*.pyd

# Local Database, Configs, and Active Selenium Profiles
download_history.db
sites_config.json
autoDownload.py
SeleniumProfile/
*.log

# IDE / editor
.vscode/
.idea/
*.swp

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Virtual environments & tooling caches
venv/
.venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
